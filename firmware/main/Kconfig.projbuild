# [Input] Board wiring choices for the ESP32-P4 pet display.
# [Output] Kconfig symbols consumed by pet_p4_lcd.c / pet_p4_touch.c / display.h.
# [Pos] Project-level hardware configuration (menuconfig -> "PET P4 hardware").
# [Sync] If this file changes, update `firmware/.folder.md` and BUILD.md.

menu "PET P4 hardware"

    choice PET_P4_PANEL
        prompt "Installed LCD panel"
        default PET_P4_PANEL_ST7796_SPI
        help
            Selects which panel the firmware drives. The original Waveshare 4.3"
            ST7701 module went end of life; the replacement is the 鸿讯电子
            CL35BC1017-40A 3.5" ST7796 module wired through the adapter board.

        config PET_P4_PANEL_WAVESHARE_ST7701_DSI
            bool "Waveshare 4.3\" ST7701 (MIPI DSI, 480x640)"

        config PET_P4_PANEL_ST7796_SPI
            bool "CL35BC1017-40A ST7796 (4-wire SPI, 320x480)"
    endchoice

    if PET_P4_PANEL_ST7796_SPI

        menu "ST7796 SPI wiring"

            config PET_P4_LCD_SPI_HOST
                int "SPI peripheral index"
                default 2
                range 1 3
                help
                    SPI2_HOST is the general purpose bus on ESP32-P4 (SPI1 drives
                    the flash). Change this only when the adapter board is wired
                    to another controller.

            config PET_P4_LCD_PIN_SCLK
                int "SCLK GPIO"
                default 20
                range -1 54

            config PET_P4_LCD_PIN_MOSI
                int "MOSI (SDA) GPIO"
                default 21
                range -1 54

            config PET_P4_LCD_PIN_CS
                int "CS GPIO"
                default 22
                range -1 54

            config PET_P4_LCD_PIN_DC
                int "D/C GPIO"
                default 23
                range -1 54

            config PET_P4_LCD_PIN_RST
                int "RESET GPIO (-1 when tied to board reset)"
                default 51
                range -1 54

            config PET_P4_LCD_PIN_BACKLIGHT
                int "Backlight GPIO (-1 when the module has no BL control)"
                default 26
                range -1 54

            config PET_P4_LCD_SPI_CLOCK_HZ
                int "SPI clock (Hz)"
                default 40000000
                range 1000000 80000000
                help
                    40 MHz moves a full 480x320 frame in ~62 ms. The ST7796S
                    datasheet only guarantees 15 MHz for the serial write cycle,
                    so raise this only after the wiring has been verified.

            config PET_P4_LCD_SPI_QUEUE_DEPTH
                int "SPI transaction queue depth"
                default 2
                range 1 8

            config PET_P4_LCD_MIRROR_X
                bool "Mirror the panel horizontally"
                default n
                help
                    Flips MADCTL MX. Use it when the image appears left-right
                    reversed after mounting the module in its enclosure.

            config PET_P4_LCD_MIRROR_Y
                bool "Mirror the panel vertically"
                default n
                help
                    Flips MADCTL MY. MX+MY together rotate the image by 180
                    degrees without touching the software scaler.
        endmenu

        menu "FT6336 capacitive touch"

            config PET_P4_TOUCH_I2C_SDA
                int "CTP SDA GPIO"
                default 7
                range -1 54

            config PET_P4_TOUCH_I2C_SCL
                int "CTP SCL GPIO"
                default 8
                range -1 54

            config PET_P4_TOUCH_I2C_HZ
                int "CTP I2C clock (Hz)"
                default 100000
                range 10000 400000
                help
                    FT6336U is documented at 100 kHz; 400 kHz usually works but
                    is out of spec for the controller.

            config PET_P4_TOUCH_MIRROR_X
                bool "Mirror touch X axis"
                default n

            config PET_P4_TOUCH_MIRROR_Y
                bool "Mirror touch Y axis"
                default n
                help
                    Touch orientation is independent from the LCD MADCTL bits.
                    If taps land mirrored, flip these before editing code.
        endmenu

    endif

endmenu
