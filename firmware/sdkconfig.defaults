CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_SPIFFS_GC_MAX_RUNS=64
CONFIG_SPIFFS_PAGE_SIZE=512
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_ESP_H264_DECODER_IRAM=y
# The 640x480 profile has 30 coded macroblock rows and is safe for tinyh264's
# row-paired dual-task acceleration on ESP32-P4.
CONFIG_ESP_H264_DUAL_TASK=y
CONFIG_ESP_H264_DUAL_TASK_CORE=1
CONFIG_ESP_H264_DUAL_TASK_PRIORITY=17

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Replacement LCD: 鸿讯电子 CL35BC1017-40A (ST7796S, 4-wire SPI, 320x480).
# The original Waveshare ST7701 module is end of life; select the DSI option in
# `idf.py menuconfig` -> "PET P4 hardware" to build for the old glass.
CONFIG_PET_P4_PANEL_ST7796_SPI=y
CONFIG_PET_P4_LCD_SPI_HOST=2
CONFIG_PET_P4_LCD_PIN_SCLK=20
CONFIG_PET_P4_LCD_PIN_MOSI=21
CONFIG_PET_P4_LCD_PIN_CS=22
CONFIG_PET_P4_LCD_PIN_DC=23
CONFIG_PET_P4_LCD_PIN_RST=51
CONFIG_PET_P4_LCD_PIN_BACKLIGHT=26
CONFIG_PET_P4_LCD_SPI_CLOCK_HZ=40000000
CONFIG_PET_P4_TOUCH_I2C_SDA=7
CONFIG_PET_P4_TOUCH_I2C_SCL=8
CONFIG_PET_P4_TOUCH_I2C_HZ=100000
